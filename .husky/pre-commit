#!/bin/sh
# Pre-commit hook: runs lint checks for backend and frontend before committing

echo "Running pre-commit lint checks..."

cd backend || exit 1
npm run lint || {
  echo "Backend lint failed. Please fix before committing."
  exit 1
}

cd ../frontend || exit 1
npm run lint || {
  echo "Frontend lint failed. Please fix before committing."
  exit 1
}

echo "Pre-commit checks passed!"
exit 0
