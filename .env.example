NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Render & Cloud Deployment Settings
# Comma-separated allowed frontend origins (e.g. https://your-app.vercel.app,http://localhost:5173)
# ALLOW_VERCEL_PREVIEWS=true allows any *.vercel.app deployment preview to talk to the backend
ALLOW_VERCEL_PREVIEWS=false
# Cookies for cross-site authentication (Render backend + Vercel frontend)
# Use 'none' with COOKIE_SECURE=true for cross-site production, 'lax' for local development
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Render Free Tier Keep-Alive (Prevents 15-minute inactivity spin-down)
# Automatically uses RENDER_EXTERNAL_URL if deployed on Render, or KEEP_ALIVE_URL if specified
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=12
# KEEP_ALIVE_URL=https://your-service.onrender.com

# PostgreSQL - Development & Production
DATABASE_URL=postgresql://user:password@localhost:5432/budget_tracker
DIRECT_URL=postgresql://user:password@localhost:5432/budget_tracker

# PostgreSQL - Dedicated Test Database (Isolated from dev/prod)
DATABASE_URL_TEST=postgresql://user:password@localhost:5432/budget_tracker_test
DIRECT_URL_TEST=postgresql://user:password@localhost:5432/budget_tracker_test

# Supabase Auth / Keys (if applicable)
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE=your_supabase_service_role

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Timezone
TZ=Asia/Kolkata

# Blockchain / Ledger Anchoring (Iteration L)
LEDGER_CHAIN=disabled
LEDGER_RPC_URL=http://127.0.0.1:8545
LEDGER_CONTRACT_ADDRESS=
LEDGER_SIGNER_PRIVATE_KEY=
LEDGER_EXPECTED_CHAIN_ID=31337
LEDGER_CONFIRMATIONS=1
LEDGER_EXPLORER_BASE_URL=
LEDGER_SETTLE_SECONDS=120
LEDGER_BATCH_MAX=1000
LEDGER_ENABLED=false
LEDGER_INTERVAL_MINUTES=60
