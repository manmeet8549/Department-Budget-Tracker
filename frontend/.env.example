# Frontend Environment Variables

# The public URL of the deployed backend API.
# On Vercel, set this in Project Settings -> Environment Variables.
# Examples:
# - Production: https://budget-tracker-backend.onrender.com (or with /api/v1)
# - Local Development: http://localhost:5000/api/v1 (or leave blank to use Vite dev proxy)
VITE_API_URL=https://your-backend-service.onrender.com

