{
  "openapi": "3.0.3",
  "info": {
    "title": "Department Budget Spending Tracker API",
    "version": "0.1.0",
    "description": "RESTful JSON API for the college budget management system.\n\nBase path: `/api/v1`. All responses: `{ success, data }` or `{ success, error: { code, message, details } }`.\n\nAuthentication: `Authorization: Bearer <accessToken>`."
  },
  "servers": [
    { "url": "http://localhost:5000/api/v1", "description": "Local development" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Liveness probe. No authentication required.",
        "tags": ["System"],
        "operationId": "getHealth",
        "responses": {
          "200": { "description": "Service is running" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User login",
        "description": "Authenticates user with email and password. Returns access token in response body and sets refresh token in httpOnly cookie.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "superadmin@college.edu" },
                  "password": { "type": "string", "example": "Password@123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials or user disabled" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "description": "Generates a new access token using the refresh token cookie.",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Token refreshed" },
          "401": { "description": "Missing or expired refresh token" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "User logout",
        "description": "Clears the refresh token cookie.",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/auth/change-password": {
      "post": {
        "summary": "Change password",
        "description": "Allows an authenticated user to change their password.",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string" },
                  "newPassword": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated" },
          "400": { "description": "Invalid current password or new password format" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users",
        "description": "List users with role and department details. Restricted to SUPER_ADMIN.",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Users retrieved" },
          "403": { "description": "Access denied" }
        }
      },
      "post": {
        "summary": "Create user",
        "description": "Creates a new user. Restricted to SUPER_ADMIN.",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "role"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 },
                  "name": { "type": "string" },
                  "role": { "type": "string", "enum": ["SUPER_ADMIN", "MANAGEMENT", "FINANCE", "HOD", "STAFF", "AUDITOR"] },
                  "departmentId": { "type": "integer", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/users/{id}": {
      "patch": {
        "summary": "Update user",
        "description": "Updates or disables a user. Restricted to SUPER_ADMIN.",
        "tags": ["Users"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" },
                  "departmentId": { "type": "integer", "nullable": true },
                  "isActive": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User updated" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "summary": "List audit logs",
        "description": "Returns immutable audit logs with pagination and filters. Restricted to SUPER_ADMIN.",
        "tags": ["Audit"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Audit logs retrieved" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/financial-years": {
      "get": {
        "summary": "List financial years",
        "tags": ["Master - Financial Years"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Financial years list" }
        }
      },
      "post": {
        "summary": "Create financial year",
        "tags": ["Master - Financial Years"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["year", "startDate", "endDate"],
                "properties": {
                  "year": { "type": "string", "example": "2024-2025" },
                  "startDate": { "type": "string", "format": "date" },
                  "endDate": { "type": "string", "format": "date" },
                  "status": { "type": "string", "enum": ["OPEN", "CLOSED"], "default": "OPEN" },
                  "isActive": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Financial year created" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/financial-years/{id}": {
      "patch": {
        "summary": "Update financial year",
        "tags": ["Master - Financial Years"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Financial year updated" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/financial-years/{id}/activate": {
      "post": {
        "summary": "Mark financial year as active",
        "description": "Enforces that only one financial year is active at a time.",
        "tags": ["Master - Financial Years"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Financial year marked active" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/departments": {
      "get": {
        "summary": "List departments",
        "tags": ["Master - Departments"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Departments list" }
        }
      },
      "post": {
        "summary": "Create department",
        "tags": ["Master - Departments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "name"],
                "properties": {
                  "code": { "type": "string", "example": "CS" },
                  "name": { "type": "string", "example": "Computer Science" },
                  "parentId": { "type": "integer", "nullable": true },
                  "hodUserId": { "type": "integer", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Department created" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/departments/{id}": {
      "get": {
        "summary": "Get department by ID",
        "tags": ["Master - Departments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Department details" }
        }
      },
      "patch": {
        "summary": "Update department",
        "tags": ["Master - Departments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Department updated" },
          "403": { "description": "Access denied" }
        }
      },
      "delete": {
        "summary": "Deactivate department (soft delete)",
        "tags": ["Master - Departments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Department deactivated" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "List categories",
        "tags": ["Master - Categories"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Categories list" }
        }
      },
      "post": {
        "summary": "Create category",
        "tags": ["Master - Categories"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "example": "Equipment" },
                  "description": { "type": "string", "nullable": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Category created" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "summary": "Get category by ID",
        "tags": ["Master - Categories"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Category details" }
        }
      },
      "patch": {
        "summary": "Update category",
        "tags": ["Master - Categories"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Category updated" },
          "403": { "description": "Access denied" }
        }
      },
      "delete": {
        "summary": "Deactivate category (soft delete)",
        "tags": ["Master - Categories"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Category deactivated" },
          "403": { "description": "Access denied" }
        }
      }
    },
    "/budgets": {
      "get": {
        "summary": "List budgets",
        "description": "Returns budgets. Scoped by role: HOD and STAFF see only their own department; MANAGEMENT, FINANCE, AUDITOR, SUPER_ADMIN see all.",
        "tags": ["Budgets"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "financialYearId", "in": "query", "schema": { "type": "integer" } },
          { "name": "departmentId", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "APPROVED"] } }
        ],
        "responses": {
          "200": { "description": "List of budgets" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create annual budget proposal",
        "description": "Creates a budget in DRAFT status with category items. HOD can create for own department; FINANCE can create for any department.",
        "tags": ["Budgets"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["financialYearId", "departmentId", "totalAmount", "items"],
                "properties": {
                  "financialYearId": { "type": "integer", "example": 1 },
                  "departmentId": { "type": "integer", "example": 1 },
                  "totalAmount": { "type": "number", "example": 1000000.00 },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["categoryId", "amount"],
                      "properties": {
                        "categoryId": { "type": "integer", "example": 1 },
                        "amount": { "type": "number", "example": 500000.00 },
                        "justification": { "type": "string", "example": "Lab equipment upgrade" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Budget created" },
          "400": { "description": "Sum of items does not match totalAmount or validation failure" },
          "403": { "description": "Forbidden for role or outside department scope" },
          "409": { "description": "Duplicate budget for department and financial year" }
        }
      }
    },
    "/budgets/{id}": {
      "get": {
        "summary": "Get budget details",
        "description": "Returns budget details including all category items.",
        "tags": ["Budgets"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Budget details" },
          "403": { "description": "Forbidden (HOD/STAFF outside department scope)" },
          "404": { "description": "Budget not found" }
        }
      },
      "put": {
        "summary": "Update DRAFT budget",
        "description": "Updates items and total amount of a DRAFT budget. APPROVED budgets are frozen and return 409.",
        "tags": ["Budgets"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["totalAmount", "items"],
                "properties": {
                  "totalAmount": { "type": "number", "example": 1200000.00 },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["categoryId", "amount"],
                      "properties": {
                        "categoryId": { "type": "integer", "example": 1 },
                        "amount": { "type": "number", "example": 600000.00 },
                        "justification": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Budget updated" },
          "400": { "description": "Sum of items does not match totalAmount" },
          "403": { "description": "Forbidden" },
          "409": { "description": "Cannot edit an APPROVED budget" }
        }
      }
    },
    "/budgets/{id}/approve": {
      "post": {
        "summary": "Approve budget proposal",
        "description": "Approve a DRAFT budget in a single step. Freezes budget and records approval metadata. MANAGEMENT role only.",
        "tags": ["Budgets"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Budget approved and frozen" },
          "403": { "description": "Forbidden (only MANAGEMENT can approve)" },
          "404": { "description": "Budget not found" },
          "409": { "description": "Budget is already approved or not in DRAFT" }
        }
      }
    },
    "/balances": {
      "get": {
        "summary": "Get college or department balance summary",
        "description": "Calculates Allocated, Committed, Spent, Available, and Utilisation % over approved budgets and expenses. Allowed: MANAGEMENT, FINANCE, AUDITOR, SUPER_ADMIN (any dept), HOD and STAFF (own dept only).",
        "tags": ["Balances"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "financialYearId", "in": "query", "schema": { "type": "integer" } },
          { "name": "departmentId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Balance summary retrieved" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden (scoping violation)" }
        }
      }
    },
    "/balances/{deptId}/categories": {
      "get": {
        "summary": "Get category-wise balance breakdown for a department",
        "description": "Returns allocated, committed, spent, available, and utilisation % per category. Allowed: MANAGEMENT, FINANCE, AUDITOR, SUPER_ADMIN, HOD & STAFF (own dept).",
        "tags": ["Balances"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "deptId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "financialYearId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Category balances retrieved" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/expenses": {
      "get": {
        "summary": "List expenses with pagination and filters",
        "description": "Filter by financialYearId, departmentId, categoryId, status. Scoped: HOD/STAFF own dept, FINANCE/MANAGEMENT/AUDITOR/SUPER_ADMIN all.",
        "tags": ["Expenses"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "financialYearId", "in": "query", "schema": { "type": "integer" } },
          { "name": "departmentId", "in": "query", "schema": { "type": "integer" } },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "APPROVED", "REJECTED", "PAID", "CANCELLED"] } }
        ],
        "responses": {
          "200": { "description": "Paginated list of expenses" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a DRAFT expense",
        "description": "Creates an expense draft. Amount > 0, active category, active department, active open FY, and department must have an APPROVED budget. Allowed: HOD, STAFF (own dept only).",
        "tags": ["Expenses"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["financialYearId", "departmentId", "categoryId", "amount", "purpose"],
                "properties": {
                  "financialYearId": { "type": "integer" },
                  "departmentId": { "type": "integer" },
                  "categoryId": { "type": "integer" },
                  "amount": { "type": "number", "example": 15000 },
                  "purpose": { "type": "string", "example": "Laboratory glassware" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "DRAFT expense created" },
          "400": { "description": "Validation error or invalid state" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "summary": "Get expense details",
        "tags": ["Expenses"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense details" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "summary": "Edit a DRAFT expense",
        "description": "Edits a draft expense. Only the creator or an HOD of that department can edit. Non-draft returns 409.",
        "tags": ["Expenses"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "categoryId": { "type": "integer" },
                  "amount": { "type": "number" },
                  "purpose": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Expense updated" },
          "403": { "description": "Forbidden (not creator or HOD)" },
          "404": { "description": "Not found" },
          "409": { "description": "Expense is not in DRAFT status" }
        }
      },
      "delete": {
        "summary": "Delete a DRAFT expense",
        "description": "Deletes a draft expense. Only the creator or an HOD of that department can delete. Non-draft returns 409.",
        "tags": ["Expenses"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Expense deleted" },
          "403": { "description": "Forbidden (not creator or HOD)" },
          "404": { "description": "Not found" },
          "409": { "description": "Expense is not in DRAFT status" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "UNAUTHORIZED" },
              "message": { "type": "string" },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
